EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Contas demo padrão (funcionam sem Supabase):
# cliente@demo.com / demo123  → Cliente
# dono@demo.com    / demo123  → Dono
# admin@demo.com   / demo123  → Admin

# Maps — GPS sempre usa o dispositivo (expo-location).
# Google: 3D nativo no Android. Mapbox: reservado para GL 3D no web (src/maps/README.md).
# Sem chave: Leaflet (web) / Apple Maps ou default (iOS/Android).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Pagamento Pix
EXPO_PUBLIC_PIX_KEY=
# Opcional: Mercado Pago (gera Pix real)
EXPO_PUBLIC_MERCADOPAGO_ACCESS_TOKEN=
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
